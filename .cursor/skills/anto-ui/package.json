{
  "name": "@xplshn/anto-ui",
  "version": "0.1.0",
  "description": "Anto design system: a suckless, terminal-flavored React component kit with PWA and haptics helpers.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens.css": "./src/tokens.css",
    "./sw-template.js": "./src/sw-template.js",
    "./fonts/*": "./src/fonts/*"
  },
  "files": [
    "dist",
    "src/tokens.css",
    "src/sw-template.js",
    "src/fonts",
    "SKILL.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --external react --external react-dom",
    "dev": "tsup src/index.ts --format esm,cjs --dts --external react --external react-dom --watch"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "dependencies": {
    "@types/react-dom": "^19.2.3"
  }
}
