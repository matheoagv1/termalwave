{
  "version": 1,
  "group_kind": { "sar": "sar", "weather": "weather", "stations": "crew" },
  "entries": [
    {
      "id": "nisar", "label": "NISAR", "operator": "NASA / ISRO",
      "match": { "norad": [65053], "name": "^NISAR$" },
      "kind": "sar", "band": "L + S", "sensor": "L-SAR + S-SAR (SweepSAR)", "mode": "SweepSAR",
      "swath_km": 242, "look": "left", "incidence_deg": [33, 47], "altitude_km": 747, "repeat_days": 12,
      "sources": ["nisar-facts", "nisar-handbook"]
    },
    {
