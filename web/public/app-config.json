  "space": {
    "sky_assets": "./sky/",
    "satellite_assets": "./satellites/",
    "ephemeris": {
      "endpoint": "/api/ephemeris",
      "upstream": "https://ssd.jpl.nasa.gov/api/horizons.api",
      "bodies": {
        "sun": "10",
        "moon": "301",
        "mercury": "199",
        "venus": "299",
        "mars": "499",
        "jupiter": "599",
        "saturn": "699"
      },
      "step_hours": 1
    },
    "satellites": {
      "endpoint": "/api/satellites",
      "upstream": "https://celestrak.org/NORAD/elements/gp.php",
      "groups": [
        "sar",
        "weather",
        "stations"
      ],
      "default_group": "sar",
      "highlight": [
        "NISAR",
        "SAOCOM 1A",
        "SAOCOM 1B",
        "SENTINEL-1C",
        "SENTINEL-1D",
        "ALOS-4 (DAICHI-4)"
