      "cache_ttl_s": 7200,
      "min_elevation_deg": 10
    },
    "clouds": {
      "endpoint": "/api/clouds",
      "upstream": "https://nowcoast.noaa.gov/geoserver/observations/satellite/ows",
      "layer": "global_longwave_imagery_mosaic",
      "attribution": "NOAA nowCOAST · NESDIS global infrared mosaic",
      "manifest_ttl_s": 600,
      "max_zoom": 6
    },
    "wind": {
      "endpoint": "/api/wind",
      "forecast": "https://api.open-meteo.com/v1/forecast",
      "archive": "https://archive-api.open-meteo.com/v1/archive",
      "cache_ttl_s": 900,
      "attribution": "Open-Meteo (CC BY 4.0)"
    }
  },
  "search": {
    "endpoint": "/api/search",
    "proxy": [
      "google_places",
      "photon",
      "open_meteo_geocode"
