  },
  "space": {
    "sky_assets": "./sky/",
    "satellite_assets": "./satellites/",
    "ephemeris": {
      "endpoint": "/api/ephemeris",
      "upstream": "https://ssd.jpl.nasa.gov/api/horizons.api",
      "bodies": {
        "sun": "10",
        "moon": "301",
        "mercury": "199",
        "venus": "299",
        "mars": "499",
        "jupiter": "599",
        "saturn": "699"
      },
      "step_hours": 1
    },
    "satellites": {
      "endpoint": "/api/satellites",
      "upstream": "https://celestrak.org/NORAD/elements/gp.php",
      "groups": [
        "sar",
        "weather",
        "stations"
      ],
      "default_group": "sar",
      "highlight": [
        "NISAR",
        "SAOCOM 1A",
        "SAOCOM 1B",
        "SENTINEL-1C",
        "SENTINEL-1D",
        "ALOS-4 (DAICHI-4)"
      ],
      "cache_ttl_s": 7200,
      "min_elevation_deg": 10
    },
    "clouds": {
      "endpoint": "/api/clouds",
      "upstream": "https://nowcoast.noaa.gov/geoserver/observations/satellite/ows",
      "layer": "global_longwave_imagery_mosaic",
      "attribution": "NOAA nowCOAST · NESDIS global infrared mosaic",
      "manifest_ttl_s": 600,
      "max_zoom": 6
    }
  },
  "search": {
    "endpoint": "/api/search",
    "proxy": [
      "google_places",
      "photon",
      "open_meteo_geocode"
    ],
    "direct": [
      "photon",
      "open_meteo_geocode"
    ],
    "limit": 6,
    "cache_ttl_s": 604800,
    "user_agent": "TermalWave/0.1 (+https://termalwave.space)",
    "endpoints": {
      "google_places": "https://places.googleapis.com/v1/places:searchText",
      "photon": "https://photon.komoot.io/api/",
      "open_meteo_geocode": "https://geocoding-api.open-meteo.com/v1/search"
    }
  }
