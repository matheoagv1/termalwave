# Raw NISAR downloads (not committed)
data/raw/**
!data/raw/.gitkeep

# Ignore HDF5 granules everywhere except the tiny committed fixture
*.h5
!data/fixtures/
!data/fixtures/**/*.h5

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
.env
config/secrets.local.toml
data/cache/**
!data/cache/.gitkeep
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg

# Node / Vite (source deps only; web/dist is committed)
web/node_modules/
web/.vite/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Vendor build scratch
vendor/.wheels/
vendor/.tmp/

# SSH private keys for team (never commit)
ssh-keys/

.worktrees/

# Large local code-reference drops (look on VPS disk; not agent docs)
references/gods-eye-view/
references/SgoLinea/
preview/node_modules/
config/google/

# Local agent/tooling state (per worktree, never committed)
.tw/
.cursor/mcp.json
.pytest_cache/

# Local backups left by tooling
comms.worktree-bak-*/
*.carne-bak

# New hub daemon state (per worktree)
.twd/
.land/
.npm-cache/
data/raw/
.tmp-dist-*/
.tw-index
