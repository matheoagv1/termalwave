{
  "name": "termalwave-preview",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "termalwave-preview-auth",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    "APP_NAME": "TermalWave Preview"
  }
}
